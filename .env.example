# Copy to .env and fill in real values. Never commit .env.
# HF_TOKEN is read by the publish script only. Do not put it in YAML.

HF_TOKEN=
HF_MODEL_ID=rudra11/vaakku-whisper-small

# On the g5 box these point at the instance-store mount, not the 64 GiB root disk.
VAAKKU_DATA_ROOT=/home/ubuntu/vaaku
VAAKKU_DATA_DIR=/home/ubuntu/vaaku/data
VAAKKU_ARTIFACT_DIR=/home/ubuntu/vaaku/artifacts
HF_HOME=/home/ubuntu/vaaku/cache/huggingface
HUGGINGFACE_HUB_CACHE=/home/ubuntu/vaaku/cache/huggingface/hub
HF_DATASETS_CACHE=/home/ubuntu/vaaku/cache/huggingface/datasets
PIP_CACHE_DIR=/home/ubuntu/vaaku/cache/pip
TMPDIR=/home/ubuntu/vaaku/tmp

VAAKKU_BASE_MODEL_ID=openai/whisper-small
VAAKKU_MODEL_ID=
VAAKKU_MODEL_PATH=
VAAKKU_DEVICE=auto
VAAKKU_API_URL=http://127.0.0.1:8000
VAAKKU_LOG_DIR=/home/ubuntu/vaaku/artifacts/logs
